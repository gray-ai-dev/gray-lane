  },
  "dependencies": {
    "@gray/attest": "0.0.0",
    "@gray/json": "0.0.0",
    "@gray/lane": "0.0.0",
    "@gray/relay-connector": "0.0.0",
    "@msgpack/msgpack": "3.1.3",
    "@noble/hashes": "1.8.0",
    "@phala/dcap-qvl": "0.7.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@gray/conformance": "0.0.0",
    "@types/ws": "8.18.2"
  }
}

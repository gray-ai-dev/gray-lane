{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-plugin/types"],
    "resolveJsonModule": true
  },
  // ../tooling/workerd: the setup file every workerd test file runs (tooling/vitest.ts workerdConfig), typed here with

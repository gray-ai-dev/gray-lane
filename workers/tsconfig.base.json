// Shared compiler options of every new package and Worker (copied from workers/credit/tsconfig.json).
// erasableSyntaxOnly keeps every source file loadable by Node's type stripping, so deploy and docs
// scripts can import a package (for example @gray/config) without a build step. That is also why a JSON module is
// imported `with { type: "json" }` (Node refuses one without it), which needs "module" esnext.
{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "es2024.string"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "noEmit": true
  }
}
